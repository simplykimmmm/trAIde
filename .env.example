# Copy this file to .env.local and fill in local-only values.
# Never commit .env.local or real secrets.

# Default mode is paper trading. Keep this false unless you understand the risks.
LIVE_TRADING=false
AUTO_PAPER_TRADING=true

# Real eToro integration is intentionally disabled by default.
# Read-only quote integration requires BOTH keys. A public key alone is not enough.
USE_REAL_ETORO=false
ETORO_PUBLIC_KEY=
ETORO_USER_KEY=

# Gemini is optional. With no key, the app returns validated cautious mock HOLD analyses.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_DELAY_MS=1200

# Optional live/delayed quote data. If omitted, the app uses mock quotes.
FINNHUB_API_KEY=

# Optional persistent paper-trading storage. If omitted, local SQLite is used.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY is also supported as an alias for SUPABASE_SERVICE_ROLE_KEY.

# Opportunity scanner: server-side news/volatility discovery for paper-trading candidates.
OPPORTUNITY_SCANNER=true
OPPORTUNITY_UNIVERSE=SPY,QQQ,AAPL,MSFT,GOOGL,AMZN,AMD,COIN,META,NVDA,PLTR,SOFI,TSLA,BTC/USD,ETH/USD,SOL/USD,DOGE/USD
OPPORTUNITY_LIMIT=15
OPPORTUNITY_MAX_SCAN_SYMBOLS=35
OPPORTUNITY_MIN_SCORE=12
WEEKEND_CRYPTO_ONLY=true

# Comma-separated watchlist. Unsupported symbols are skipped by the adapter.
WATCHLIST=SPY,QQQ,AAPL,MSFT,GOOGL,BTC/USD,ETH/USD

# Paper account and risk defaults.
PAPER_START_BALANCE=100000
MAX_RISK_PER_TRADE_PCT=0.05
MAX_DAILY_LOSS_PCT=1
MAX_OPEN_POSITIONS=25
MIN_AI_CONFIDENCE=0.5
ALLOW_LEVERAGE=true
ALLOW_SHORT_SELLING=false
PAPER_EXPOSURE_MULTIPLIER=20
MAX_ACCOUNT_RISK_PCT=1
DATA_STALE_THRESHOLD_MS=60000

# Paper execution realism. These make paper fills less optimistic than perfect fills.
PAPER_FIXED_FEE_USD=1
PAPER_FEE_BPS=10
PAPER_SPREAD_BPS=10
PAPER_SLIPPAGE_BPS=15
PAPER_MARKET_IMPACT_BPS=35
PAPER_MAX_MARKET_IMPACT_BPS=150
PAPER_STOP_GAP_BPS=35
PAPER_MAX_POSITION_NOTIONAL_PCT=0.25
PAPER_STOCK_LIQUIDITY_CAP_USD=15000
PAPER_CRYPTO_LIQUIDITY_CAP_USD=25000
